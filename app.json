{
  "expo": {
    "name": "PetPerdidoSOS",
    "slug": "PetPerdidoSOS",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./logotipo/icon.png",
    "scheme": "petperdidosos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.ricavallini.petperdidosos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FB5066",
        "backgroundImage": "./logotipo/adaptive-bg.png",
        "foregroundImage": "./logotipo/adaptive-fg.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ricavallini.petperdidosos"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./logotipo/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FB5066",
          "dark": {
            "image": "./logotipo/splash-icon.png",
            "backgroundColor": "#FB5066"
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#FF4757"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "appBuild": 4,
      "eas": {
        "projectId": "299ba12b-eefa-4abf-a4b5-f00d911c4996"
      }
    }
  }
}
