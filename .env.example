# Exemplo de variáveis de ambiente do app (copie para .env e preencha).
# Tudo que começa com EXPO_PUBLIC_ é embutido no app no build.

# Backend
EXPO_PUBLIC_API_URL=https://api.imestredigital.cloud

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Google Maps (chaves restritas por plataforma no Google Cloud)
EXPO_PUBLIC_GOOGLE_MAPS_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_KEY_IOS=

# Login social com Google (Google Cloud > Credenciais > IDs do cliente OAuth)
# WEB_CLIENT_ID: obrigatório — é a "audience" do idToken no Android e iOS
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# IOS_CLIENT_ID + IOS_URL_SCHEME (reversed client ID): só necessários no build iOS
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
