PORT=3005
SUPABASE_URL=https://daxawxyjysutewsulsgk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key-do-supabase-dashboard

# Reconhecimento de pet por foto (CLIP). Pegue em https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# IA do chat de suporte (Anthropic)
ANTHROPIC_API_KEY=

# CORS: origens web permitidas, separadas por vírgula (ex.: o painel admin).
# Vazio = libera todas (apenas para desenvolvimento). O app mobile não envia
# Origin, então não é afetado por esta lista.
ALLOWED_ORIGINS=http://localhost:5173

# Sentry (monitoramento de erros do backend) — DSN do projeto Node/Express
SENTRY_DSN=

# Distribuição interna do app (auto-update): pasta no VPS com o .apk + version.json
APP_RELEASE_DIR=/root/petperdidosos-releases
